programa
{
	funcao inicio()
	{
		inteiro op

		leia(op)

		escolha(op)
		{
			caso 1:
				escreva("Encaminhando para Vendas")
				pare

			caso 2:
				escreva("Encaminhando para Suporte Técnico")
				pare

			caso 3:
				escreva("Encaminhando para o Financeiro")
				pare

			caso 0:
				escreva("Encerrando chamada")
				pare
		}
	}
}