programa
{
	funcao inicio()
	{
		cadeia nome_produto = "Notebook ASUS ROG"
		inteiro quantidade = 2
		real valor_total = 5000.00
		cadeia frete = "Grátis"

		escreva("===== RESUMO DA COMPRA =====\n")
